# Copy to .env and replace these placeholders with separate random local passwords.
# Use only URI-unreserved characters (letters, digits, -, ., _, ~), e.g. a
# password generated by: openssl rand -hex 24
POSTGRES_PASSWORD=replace-with-a-random-hex-value
DRAGONFLY_PASSWORD=replace-with-a-separate-random-hex-value

# Optional: choose the Dragonfly image tag used by the local broker backend.
DRAGONFLY_IMAGE_TAG=latest

# All local HTTP URLs use <service>.localhost:8080 (see README.md).
# Optional: change the shared port and use it in every local browser URL.
LOCAL_PORT=8080

# Optional: choose the Dozzle image tag used by the local log viewer.
DOZZLE_IMAGE_TAG=latest

# Optional: tag assigned to the locally built gateway image.
ACCESS_GATEWAY_IMAGE_TAG=dev

# Optional local S3 demo: docker compose --profile storage-demo up --build -d
# Set a fresh local password (at least eight characters); never reuse a cloud key.
S3_DEV_PASSWORD=replace-with-a-random-local-password

# Temporary casting shares and delegated playback: positive duration, at most 24h.
CAST_SHARE_TTL=6h
