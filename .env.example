# Copy to .env and replace these placeholders with separate random local passwords.
# Use only URI-unreserved characters (letters, digits, -, ., _, ~), e.g. a
# password generated by: openssl rand -hex 24
POSTGRES_PASSWORD=replace-with-a-random-hex-value
VALKEY_PASSWORD=replace-with-a-separate-random-hex-value

# Optional: choose the Valkey image tag (9.1.0+ for numbered database ACLs).
VALKEY_IMAGE_TAG=9.1.0-alpine

# Homepage: localhost:8080; services: <service>.localhost:8080 (see README.md).
# Optional: change the shared port and use it in every local browser URL.
LOCAL_PORT=8080

# Optional: choose the Dozzle image tag used by the local log viewer.
DOZZLE_IMAGE_TAG=latest

# Optional: tag assigned to the locally built gateway image.
ACCESS_GATEWAY_IMAGE_TAG=dev

# Optional local S3 demo: docker compose --profile storage-demo up --build -d
# Set a fresh local password (at least eight characters); never reuse a cloud key.
S3_DEV_PASSWORD=replace-with-a-random-local-password

# Files plaintext upload limit per file, in bytes (10 GiB).
MAX_UPLOAD_BYTES=10737418240

# Temporary casting shares and delegated playback: positive duration, at most 24h.
CAST_SHARE_TTL=6h

# Notes uses the same connection setup as Files. With storage-demo enabled,
# add http://s3-demo:9000, region us-east-1, path-style addressing, access key
# files-dev and S3_DEV_PASSWORD in Notes' Storage page. Attach bucket files-demo
# under a dedicated prefix, with optional rclone encryption.

# Optional landing app-list JSON; Files and Notes are supplied as examples.
LANDING_APPS_FILE=./infra/landing-apps.json

# Broker token mode is enabled by default. Run make local-auth once before up.
# Independent development keys/tokens live only in ignored .local/broker-auth/.
# Explicit legacy mode: docker compose -f docker-compose.yml -f docker-compose.none.yml up
