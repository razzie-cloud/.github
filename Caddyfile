{
	admin off
}

http://localhost:{$LOCAL_PORT:8080} {
	reverse_proxy landing:8080
}

http://auth.localhost:{$LOCAL_PORT:8080} {
	reverse_proxy access-gateway:8080
}

http://whoami.localhost:{$LOCAL_PORT:8080} {
	route {
		request_header -X-Auth-Request-User
		request_header -X-Auth-Request-Name
		# Every path, including /_auth/callback, passes through the gateway.
		forward_auth access-gateway:8080 {
			uri /forward_auth
			copy_headers X-Auth-Request-User X-Auth-Request-Name
		}
		reverse_proxy whoami:80 {
			# Keep the demo's header echo from displaying session cookies.
			header_up -Cookie
		}
	}
}

http://files.localhost:{$LOCAL_PORT:8080} {
	route {
		request_header -X-Auth-Request-User
		request_header -X-Auth-Request-Name
		forward_auth access-gateway:8080 {
			uri /forward_auth
			copy_headers X-Auth-Request-User X-Auth-Request-Name
		}
		reverse_proxy files:8080
	}
}

http://logs.localhost:{$LOCAL_PORT:8080} {
	route {
		request_header -X-Auth-Request-User
		request_header -X-Auth-Request-Name
		# Dozzle also reads optional proxy headers; never trust client values.
		request_header -Remote-*
		# Include every path, including the SSO callback and streaming APIs.
		forward_auth access-gateway:8080 {
			uri /forward_auth/admin
			copy_headers X-Auth-Request-User X-Auth-Request-Name
		}
		reverse_proxy dozzle:8080
	}
}

# Capability routes are public and isolated from the authenticated files UI.
http://shared-files.localhost:{$LOCAL_PORT:8080} {
	route {
		request_header -X-Auth-Request-User
		request_header -X-Auth-Request-Name
		@shared path /s/* /static/*
		reverse_proxy @shared files:8080
		respond 404
	}
}

http://notes.localhost:{$LOCAL_PORT:8080} {
	route {
		request_header -X-Auth-Request-User
		request_header -X-Auth-Request-Name
		request_header -X-Notes-Admin
		@notes_admin path /v1/admin/*
		handle @notes_admin {
			route {
				forward_auth access-gateway:8080 {
					uri /forward_auth/admin
					copy_headers X-Auth-Request-User X-Auth-Request-Name
				}
				request_header X-Notes-Admin true
				reverse_proxy notes:8080
			}
		}
		handle {
			forward_auth access-gateway:8080 {
				uri /forward_auth
				copy_headers X-Auth-Request-User X-Auth-Request-Name
			}
			reverse_proxy notes:8080
		}
	}
}
