{
	admin off
}

http://localhost:{$AUTH_PORT:8080} {
	reverse_proxy access-gateway:8080
}

http://127.0.0.1:{$WHOAMI_PORT:8081} {
	route {
		request_header -X-Auth-Request-User
		request_header -X-Auth-Request-Name
		# Every path, including /_auth/callback, passes through the gateway.
		forward_auth access-gateway:8080 {
			uri /forward_auth
			copy_headers X-Auth-Request-User X-Auth-Request-Name
		}
		reverse_proxy whoami:80 {
			# Keep the demo's header echo from displaying session cookies.
			header_up -Cookie
		}
	}
}

# Keep app cookies on their own hostname, including when opened via localhost.
http://localhost:{$FILES_PORT:8082}, http://127.0.0.1:{$FILES_PORT:8082} {
	redir http://files.localhost:{$FILES_PORT:8082}{uri} 302
}

http://files.localhost:{$FILES_PORT:8082} {
	route {
		request_header -X-Auth-Request-User
		request_header -X-Auth-Request-Name
		forward_auth access-gateway:8080 {
			uri /forward_auth
			copy_headers X-Auth-Request-User X-Auth-Request-Name
		}
		reverse_proxy files:8080
	}
}
